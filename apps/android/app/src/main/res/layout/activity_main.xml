<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:padding="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:id="@+id/title" android:text="WNY" android:textSize="28sp"
            android:textColor="#EEF2F8" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" android:textColor="#9AA6B8" android:paddingTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/power" android:layout_marginTop="16dp"
            android:layout_width="match_parent" android:layout_height="88dp" android:text="Off"/>
        <Spinner android:id="@+id/mode" android:layout_marginTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/namesLine" android:textColor="#EEF2F8" android:paddingTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/filterLine" android:textColor="#EEF2F8" android:paddingTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/roadLine" android:textColor="#EEF2F8" android:paddingTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/ident" android:layout_marginTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New identity"/>
    </LinearLayout>
</ScrollView>
